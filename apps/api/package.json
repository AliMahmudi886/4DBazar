{
  "name": "@four-d/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:compiled": "node dist/db/migrate.js",
    "db:seed": "tsx src/db/seed.ts",
    "db:cleanup:otp": "tsx src/db/cleanup-otp.ts",
    "db:cleanup:analytics": "tsx src/db/cleanup-analytics.ts",
    "db:cleanup:market": "tsx src/db/cleanup-market.ts",
    "db:cleanup:market:compiled": "node dist/db/cleanup-market.js",
    "dev": "tsx watch src/main.ts",
    "push:vapid": "tsx src/tools/generate-vapid.ts",
    "sms:smoke": "tsx src/smoke/sms-e2e.ts",
    "notifications:worker": "tsx src/scripts/notifications-worker.ts",
    "notifications:worker:compiled": "node dist/scripts/notifications-worker.js",
    "start": "node dist/main.js",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@fastify/cors": "^10.0.1",
    "@four-d/shared": "file:../../packages/shared",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.0",
    "kysely": "0.28.8",
    "pg": "^8.23.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2"
  }
}
